@model ItemsIndexViewModel

@{
    ViewData["Title"] = "Изгубени и намерени вещи";
}

<h2>Списък с обяви</h2>
<p>Тук ще се показват обявите за изгубени и намерени вещи.</p>

<a asp-controller="Items" asp-action="Create" class="btn btn-primary">Добави нова обява</a>

@if (!Model.Items.Any())
{
    <p>Няма добавени обяви все още.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>#</th>
                <th>Заглавие</th>
                <th>Вид</th>
                <th>Място</th>
                <th>Дата</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Title</td>
                    <td>@item.Type</td>
                    <td>@item.Location</td>
                    <td>@item.Date.ToShortDateString()</td>
                </tr>
            }
        </tbody>
    </table>
}